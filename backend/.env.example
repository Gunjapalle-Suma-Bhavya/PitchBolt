PORT=5000
MONGODB_URI=mongodb://localhost:27017/ai_telephony_sales

# OpenAI Credentials
OPENAI_API_KEY=your_openai_api_key_here

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886

# LangSmith Credentials (for Tracing & Evals)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=ai-telephony-sales-agent

# Public Backend URL (e.g. ngrok or deployed server URL for Twilio TwiML Webhooks)
PUBLIC_BACKEND_URL=http://localhost:5000
